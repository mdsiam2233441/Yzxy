# ===== Required =====
BOT_TOKEN=123456789:AAH-your-token-from-BotFather
ADMIN_IDS=123456789
 
# ===== Bot info (shown in /about and /help) =====
BOT_NAME=OTT Notification Bot
BOT_VERSION=v1.0.0
OWNER_NAME=Your Name
ORIGIN=Bangladesh
DEVELOPER=@your_username
CONTACT_HANDLE=@your_username
 
# ===== Links & payment text =====
SUPPORT_URL=https://t.me/your_support_group
UPDATE_CHANNEL_URL=https://t.me/your_update_channel
CONTACT_URL=https://t.me/your_username
PAY_INFO=bKash / Nagad: 01XXXXXXXXX (Send Money)
 
# ===== Behaviour =====
POLL_SECONDS=60
TZ_HOURS=6
TZ_NAME=BDT
BUTTON_STYLE=1
 
# ===== OPTIONAL: account login per OTT (needed only if you want the Account Board to show "logged in") =====
# Notifications for added links work WITHOUT any login (public pages are read).
# Use the real login request you find in your browser (F12 -> Network) for each site. OTT names: ZEE5, JIOHOTSTAR, SONYLIV, SUNNXT, DANGALPLAY, MOJTV
#
# Email/username + password login (bot POSTs this body, {username} and {password} are filled in):
# LOGIN_URL_ZEE5=https://example.com/api/login
# LOGIN_BODY_ZEE5={"email":"{username}","password":"{password}"}
# LOGIN_OK_ZEE5=            (optional: text that must appear in the reply)
#
# API key login (bot sends the key as "Authorization: Bearer KEY"; VERIFY_URL must answer 200 only when logged in):
# VERIFY_URL_ZEE5=https://example.com/api/me
# AUTH_HEADER_ZEE5=Authorization    (or e.g. X-Api-Key)
